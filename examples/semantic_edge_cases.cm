int sum(int a, int b, int c, int d, int e, int f);

int sum(int a, int b, int c, int d, int e, int f) {
    return a + b + c + d + e + f;
}

void helper(void) {
    return;
}

int main(void) {
    int result = sum(1, 2, 3, 4, 5, 6);
    int value;
    value = result;

    helper();

    return value;
}
