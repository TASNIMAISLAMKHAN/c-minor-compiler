int add(int a, int b);

int add(int a, int b) {
    int result = a + b;
    return result;
}

int main(void) {
    int x = add(2, 3);

    {
        int x = 10;
        x = x + 1;
    }

    for (int i = 0; i < 3; i = i + 1) {
        if (i == 1) {
            continue;
        }
    }

    return x;
}
