int factorial(int n) {
    if (n <= 1) {
        return 1;
    }

    return n * factorial(n - 1);
}

void helper(void) {
    return;
}

int main(void) {
    int i = 0;
    int total = 0;
    int flag = 1;

    while (i < 5 && flag != 0) {
        if (i == 2) {
            i = i + 1;
            continue;
        }

        if (i == 4) {
            break;
        }

        total = total + i;
        i = i + 1;
    }

    for (int j = 0; j < 3 || flag == 0; j = j + 1) {
        total = total + j;
    }

    if (total > 0 || flag == 0) {
        total = total + factorial(5);
    }

    helper();

    return total;
}
